<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_duadrive_interface</name>
  <version>1.0.0</version>
  <description>Collection of classes and utils which makes using a Duatic DuaDrive easy with ros2control</description>
  <maintainer email="lnachtigall@duatic.com">Lennart Nachtigall</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <!-- PUBLIC: used in public headers -->
  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>urdf</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>duatic_duadrive_sdk</depend>
  <depend>duatic_ecat_interface</depend>
  <depend>duatic_message_logger</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <duatic_archive_root>public</duatic_archive_root>
  </export>
</package>
