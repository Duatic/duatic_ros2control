<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_geometry</name>
  <version>0.0.0</version>
  <description>Eigen3-based Geometry utilities and trajectory helpers for Duatic controllers.</description>
  <maintainer email="pvonwirth@duatic.de">Patrick Vonwirth</maintainer>
  <license>BSD3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>duatic_controller_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pinocchio</depend>
  <depend>rclcpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>